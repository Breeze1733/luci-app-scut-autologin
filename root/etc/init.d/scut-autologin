#!/bin/sh /etc/rc.common
# SCUT campus network auto-login daemon (procd service)
#
# The daemon re-reads /etc/config/scut-autologin on every cycle, so LuCI
# "Apply" takes effect on the next interval without a service restart.
# It idles (sleep 5) when main.enabled is 0.

START=99
STOP=10

USE_PROCD=1
PROG=/usr/bin/scut-autologin.sh

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
